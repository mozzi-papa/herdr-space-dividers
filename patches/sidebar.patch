+#[test]
+fn divider_groups_numeric_jump_reveals_space_below_collapsed_overflow() {
+    let mut state = divider_groups_state();
+    let mut projected = state.snapshot.as_deref().unwrap().clone();
+    for index in 4..=9 {
+        let mut workspace = projected.workspaces[1].clone();
+        workspace.workspace_id = format!("ws_{index}");
+        projected.workspaces.push(workspace);
+    }
+    state.set_snapshot(Box::new(projected));
+    state.dividers[1].members = Some((3..=9).map(|index| format!("ws_{index}")).collect());
+    state.dividers[1].collapsed = true;
+    state.compose(120, 16).unwrap();
+    state.handle_input_bytes(b"\x1b[57;9u");
+    state.compose(120, 16).unwrap();
+    assert!(!state.dividers[1].collapsed);
+    assert!(state
+        .hits
+        .workspaces
+        .iter()
+        .any(|hit| hit.workspace_id == "ws_9"));
+}
