+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn state_with(status: DividersUpdateStatus) -> DividersState {
+        DividersState {
+            version: Some("0.1.2".into()),
+            status,
+            ..Default::default()
+        }
+    }
+
+    fn release(version: &str) -> DividersRelease {
+        DividersRelease {
+            version: version.into(),
+            url: format!("{RELEASE_PAGE_PREFIX}tag/v{version}"),
+        }
+    }
+
+    #[test]
+    fn dividers_update_versions_compare_numerically_and_reject_odd_tags() {
+        assert!(is_newer("0.1.10", "0.1.9"));
+        assert!(is_newer("v0.2.0", "0.1.12"));
+        assert!(!is_newer("0.1.2", "0.1.2"));
+        assert!(!is_newer("0.1.1", "0.1.2"));
+        for bad in [
+            "",
+            "0.1",
+            "0.1.2.3",
+            "0.1.2-rc1",
+            "latest",
+            "0..2",
+            "0.1.x",
+            "-0.1.2",
+        ] {
+            assert_eq!(parse_version(bad), None, "{bad}");
+            assert!(!is_newer(bad, "0.0.1"), "{bad}");
+        }
+        assert_eq!(parse_version("v10.20.30"), Some((10, 20, 30)));
+    }
+
+    #[test]
+    fn dividers_update_release_response_accepts_only_stable_releases_of_this_repo() {
+        let ok = br#"{"tag_name":"v0.1.3","html_url":"https://github.com/mozzi-papa/herdr-space-dividers/releases/tag/v0.1.3","draft":false,"prerelease":false,"body":"x"}"#;
+        assert_eq!(parse_latest_release(ok).unwrap(), release("0.1.3"));
+        for bad in [
+            &br#"{"tag_name":"v0.1.3","html_url":"https://github.com/mozzi-papa/herdr-space-dividers/releases/tag/v0.1.3","prerelease":true}"#[..],
+            br#"{"tag_name":"v0.1.3","html_url":"https://github.com/mozzi-papa/herdr-space-dividers/releases/tag/v0.1.3","draft":true}"#,
+            br#"{"tag_name":"nightly","html_url":"https://github.com/mozzi-papa/herdr-space-dividers/releases/tag/nightly"}"#,
+            br#"{"tag_name":"v0.1.3","html_url":"https://evil.example/releases/tag/v0.1.3"}"#,
+            br#"{"tag_name":"v0.1.3"}"#,
+            b"not json",
+            b"",
+        ] {
+            assert!(parse_latest_release(bad).is_err());
+        }
+    }
+
+    #[test]
+    fn dividers_update_menu_rows_follow_the_status() {
+        use DividersMenuAction as Action;
+        let rows = |state: &DividersState| build_menu_rows(state);
+        // 실행기가 버전을 주지 않으면 메뉴에 아무것도 더하지 않습니다.
+        assert!(rows(&DividersState::default()).is_empty());
+        let idle = rows(&state_with(DividersUpdateStatus::Idle));
+        assert_eq!(
+            idle,
+            [("Herdr Space Dividers 0.1.2".to_owned(), Action::Check)]
+        );
+        // 자동 확인의 "최신"·"실패"는 조용히 두고, 직접 확인했을 때만 보여 줍니다.
+        for status in [DividersUpdateStatus::UpToDate, DividersUpdateStatus::Failed] {
+            assert_eq!(rows(&state_with(status.clone())), idle);
+            let mut manual = state_with(status);
+            manual.manual = true;
+            assert_eq!(rows(&manual).len(), 2);
+        }
+        assert_eq!(
+            rows(&state_with(DividersUpdateStatus::Checking))[1].1,
+            Action::Noop
+        );
+        let mut available = state_with(DividersUpdateStatus::Available(release("0.1.3")));
+        let labels = rows(&available);
+        assert_eq!(
+            labels[1],
+            (
+                "  0.1.3 업데이트 · 명령 복사".to_owned(),
+                Action::CopyUpdate
+            )
+        );
+        assert_eq!(labels[2].1, Action::OpenRelease);
+        available.copied = true;
+        assert!(rows(&available)[1].0.contains("복사됨"));
+    }
+
+    #[test]
+    fn dividers_update_failure_keeps_a_known_new_version() {
+        let mut state = state_with(DividersUpdateStatus::Idle);
+        apply_result(&mut state, "0.1.2", Ok(release("0.1.3")));
+        assert_eq!(
+            state.status,
+            DividersUpdateStatus::Available(release("0.1.3"))
+        );
+        state.copied = true;
+        apply_result(&mut state, "0.1.2", Err("offline".into()));
+        assert_eq!(
+            state.status,
+            DividersUpdateStatus::Available(release("0.1.3"))
+        );
+        assert!(state.copied);
+        // 더 새 버전이 나오면 복사 표시를 지우고, 같은 버전이면 최신으로 돌아갑니다.
+        apply_result(&mut state, "0.1.2", Ok(release("0.1.4")));
+        assert!(!state.copied);
+        apply_result(&mut state, "0.1.4", Ok(release("0.1.4")));
+        assert_eq!(state.status, DividersUpdateStatus::UpToDate);
+        apply_result(&mut state, "0.1.4", Err("offline".into()));
+        assert_eq!(state.status, DividersUpdateStatus::Failed);
+    }
+}
