+#[test]
+fn divider_groups_workspace_drag_changes_membership_and_cancels_outside_drop() {
+    let mut state = divider_groups_state();
+    state.dividers[1].collapsed = true;
+    state.compose(120, 40).unwrap();
+    let source = state.hits.workspaces[0].rect;
+    let target = state.hits.divider_rows[1].0;
+    divider_mvp_mouse(
+        &mut state,
+        MouseEventKind::Down(MouseButton::Left),
+        source.x + 3,
+        source.y,
+    );
+    divider_mvp_mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        target.x + 3,
+        target.y,
+    );
+    divider_mvp_mouse(
+        &mut state,
+        MouseEventKind::Up(MouseButton::Left),
+        target.x + 3,
+        target.y,
+    );
+    assert_eq!(state.dividers[0].members.as_ref().unwrap(), &["ws_2"]);
+    assert!(state.dividers[1]
+        .members
+        .as_ref()
+        .unwrap()
+        .contains(&"ws_1".into()));
+    assert!(!state.dividers[1].collapsed);
+    let changed = state.dividers.clone();
+    state.compose(120, 40).unwrap();
+    let source = state
+        .hits
+        .workspaces
+        .iter()
+        .find(|hit| hit.workspace_id == "ws_2")
+        .unwrap()
+        .rect;
+    let target = state.hits.divider_rows[1].0;
+    divider_mvp_mouse(
+        &mut state,
+        MouseEventKind::Down(MouseButton::Left),
+        source.x + 3,
+        source.y,
+    );
+    divider_mvp_mouse(
+        &mut state,
+        MouseEventKind::Drag(MouseButton::Left),
+        target.x + 3,
+        target.y,
+    );
+    let outcome = divider_mvp_mouse(&mut state, MouseEventKind::Up(MouseButton::Left), 90, 35);
+    assert!(outcome.actions.is_empty());
+    assert_eq!(state.dividers, changed);
+}
