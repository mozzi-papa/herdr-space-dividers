+// 스페이스 ws_1..ws_{count}와 (제목, 소속 번호) 분류로 시작합니다.
+fn grouped_state(count: usize, groups: &[(&str, &[usize])]) -> ClientShellState {
+    let config: Config = toml::from_str("[keys]\nswitch_workspace = 'cmd+1..9'\n").unwrap();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    let mut projected = snapshot();
+    let template = projected.workspaces[0].clone();
+    projected.workspaces = (1..=count)
+        .map(|index| {
+            let mut workspace = template.clone();
+            workspace.workspace_id = format!("ws_{index}");
+            workspace.label = format!("space-{index}");
+            workspace.focused = index == 1;
+            workspace
+        })
+        .collect();
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state.dividers = groups
+        .iter()
+        .map(|(title, members)| SidebarDivider {
+            title: (*title).into(),
+            members: Some(members.iter().map(|i| format!("ws_{i}")).collect()),
+            ..Default::default()
+        })
+        .collect();
+    state
+}
+
+fn divider_drag(state: &mut ClientShellState, from: (u16, u16), to: (u16, u16)) {
+    divider_mvp_mouse(
+        state,
+        MouseEventKind::Down(MouseButton::Left),
+        from.0,
+        from.1,
+    );
+    divider_mvp_mouse(state, MouseEventKind::Drag(MouseButton::Left), to.0, to.1);
+    divider_mvp_mouse(state, MouseEventKind::Up(MouseButton::Left), to.0, to.1);
+}
+
+fn divider_header(state: &ClientShellState, title: &str) -> Rect {
+    state
+        .hits
+        .divider_rows
+        .iter()
+        .find(|(_, index)| state.dividers[*index].title == title)
+        .map(|(rect, _)| *rect)
+        .unwrap()
+}
+
+// 구분선 제목을 다른 구분선 헤더 위 빈 줄로 끌어 그 분류 앞에 놓습니다.
+fn drag_divider_before(state: &mut ClientShellState, title: &str, before: &str) {
+    state.compose(120, 80).unwrap();
+    let from = divider_header(state, title);
+    let to = divider_header(state, before);
+    divider_drag(state, (from.x + 3, from.y), (to.x + 3, to.y - 1));
+}
+
+fn drag_divider_to_bottom(state: &mut ClientShellState, title: &str) {
+    state.compose(120, 80).unwrap();
+    let from = divider_header(state, title);
+    let bottom = state
+        .hits
+        .workspaces
+        .iter()
+        .map(|hit| hit.rect.bottom())
+        .chain(
+            state
+                .hits
+                .divider_rows
+                .iter()
+                .map(|(rect, _)| rect.bottom()),
+        )
+        .max()
+        .unwrap();
+    divider_drag(state, (from.x + 3, from.y), (from.x + 3, bottom));
+}
+
+fn divider_layout(state: &ClientShellState) -> Vec<(String, Vec<String>)> {
+    state
+        .dividers
+        .iter()
+        .map(|divider| {
+            (
+                divider.title.clone(),
+                divider.members.clone().unwrap_or_default(),
+            )
+        })
+        .collect()
+}
+
+fn layout_in(order: &[&str], layout: &[(String, Vec<String>)]) -> Vec<(String, Vec<String>)> {
+    order
+        .iter()
+        .map(|title| layout.iter().find(|(t, _)| t == title).unwrap().clone())
+        .collect()
+}
