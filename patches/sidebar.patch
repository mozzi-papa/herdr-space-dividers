+    outcome.actions.clear();
+    state.activate_context_menu_item(copy, &mut outcome);
+    assert!(
+        matches!(&outcome.actions[..],[ClientShellAction::ClipboardWrite(bytes)] if bytes=="/repo other/선택한 폴더".as_bytes())
+    );
+    let menu = ClientContextMenuOverlay {
+        target: ClientContextMenuTarget::Divider { index: 0 },
+        x: 0,
+        y: 0,
+        highlighted: 0,
+    };
+    assert!(!menu.items().iter().any(|item| matches!(
+        item.action,
+        ClientContextMenuAction::OpenFolder | ClientContextMenuAction::CopyFolderPath
+    )));
+    assert!(menu
+        .items()
+        .iter()
+        .any(|item| item.action == ClientContextMenuAction::UndoDivider));
+    state.open_workspace_context_menu("ws_2".into(), 1, 2);
+    state.active_endpoint_id =
+        ClientEndpointId::Ssh(crate::client::endpoint::ProfileId::generate());
+    outcome.actions.clear();
+    state.activate_context_menu_item(open, &mut outcome);
+    assert!(outcome.actions.is_empty());
+    assert!(state.endpoint_error.is_some());
+}
