+    assert_eq!(
+        divider_layout(&state),
+        layout_in(&["개인", "실험실", "개발"], &original)
+    );
+    // 저장용 위치는 화면 순서에서 다시 계산됩니다.
+    let positions = state
+        .dividers
+        .iter()
+        .map(|divider| divider.position)
+        .collect::<Vec<_>>();
+    assert_eq!(positions, [0, 0, 0]);
+    drag_divider_before(&mut state, "개발", "개인");
+    let positions = state
+        .dividers
+        .iter()
+        .map(|divider| divider.position)
+        .collect::<Vec<_>>();
+    assert_eq!(positions, [0, 10, 10]);
