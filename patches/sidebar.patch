+fn deserialize_dividers<'de, D>(deserializer: D) -> Result<Vec<super::SidebarDivider>, D::Error>
+where
+    D: serde::Deserializer<'de>,
+{
+    let value = serde_json::Value::deserialize(deserializer)?;
+    let Some(items) = value.as_array() else {
+        return Ok(Vec::new());
+    };
+    let mut dividers = items
+        .iter()
+        .filter_map(|item| {
+            let mut divider: super::SidebarDivider = serde_json::from_value(item.clone()).ok()?;
+            divider.title = divider
+                .title
+                .chars()
+                .filter(|ch| !ch.is_control())
+                .take(60)
+                .collect::<String>()
+                .trim()
+                .to_owned();
+            (!divider.title.is_empty()).then_some(divider)
+        })
+        .take(32)
+        .collect::<Vec<_>>();
+    dividers.sort_by_key(|divider| divider.position);
+    Ok(dividers)
+}
