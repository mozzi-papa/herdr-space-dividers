+fn divider_color_palette_hex_input_undo_and_invalid_values() {
+    let mut state = divider_groups_state();
+    let original = state.dividers.clone();
+    let mut outcome = ClientShellInput::default();
+    // 팔레트 프리셋 선택
+    state.overlay = Some(ClientShellOverlay::ContextMenu(ClientContextMenuOverlay {
+        target: ClientContextMenuTarget::Divider { index: 0 },
+        x: 1,
+        y: 1,
+        highlighted: 0,
+    }));
+    let menu_index = |state: &ClientShellState, action| match &state.overlay {
+        Some(ClientShellOverlay::ContextMenu(menu)) => {
+            menu.items().iter().position(|item| item.action == action)
+        }
+        _ => None,
+    };
+    let open = menu_index(&state, ClientContextMenuAction::DividerColor).unwrap();
+    state.activate_context_menu_item(open, &mut outcome);
+    state.activate_context_menu_item(1, &mut outcome);
+    assert_eq!(state.dividers[0].color.as_deref(), Some("#ef5350"));
+    // 직접 입력: 대문자는 소문자로 저장, 형식 오류는 무시
+    let input = |state: &mut ClientShellState, text: &str| {
+        state.overlay = Some(ClientShellOverlay::Rename(ClientRenameOverlay {
+            title: "구분선 색상",
+            input: TextEditor::new(text, false),
+            target: ClientRenameTarget::DividerColor { index: 0 },
+        }));
+        state.handle_input_bytes(b"\r");
+    };
+    input(&mut state, "#ABCDEF");
+    assert_eq!(state.dividers[0].color.as_deref(), Some("#abcdef"));
+    for invalid in ["red", "#12345", "#12345g", "ffffff"] {
+        input(&mut state, invalid);
+        assert_eq!(state.dividers[0].color.as_deref(), Some("#abcdef"));
+    }
+    // 빈 입력은 기본색
+    input(&mut state, "");
+    assert_eq!(state.dividers[0].color, None);
+    // 실행 취소는 직전 색부터 되돌림
+    state.undo_divider_edit(&mut outcome);
+    assert_eq!(state.dividers[0].color.as_deref(), Some("#abcdef"));
+    while !state.divider_undo.is_empty() {
+        state.undo_divider_edit(&mut outcome);
+    }
+    assert_eq!(state.dividers, original);
+    assert_eq!(
+        divider_color(&Some("#102030".into())),
+        Some(ratatui::style::Color::Rgb(0x10, 0x20, 0x30))
+    );
+    assert_eq!(divider_color(&Some("bad".into())), None);
+    assert_eq!(divider_color(&None), None);
+}
