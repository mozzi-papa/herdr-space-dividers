+// Modified for Herdr Space Dividers by mozzi-papa, 2026.
+// Based on Herdr v0.9.5; distributed under Apache-2.0.
+//! Herdr Space Dividers의 버전 표시와 업데이트 확인입니다. 공식 Herdr의 업데이트와는 별개입니다.
+//!
+//! 최신 버전 번호만 GitHub에서 조회하며 사용자 정보는 보내지 않습니다. 자동 설치는 하지 않고
+//! Homebrew 업데이트 명령을 안내합니다. `HERDR_DIVIDERS_NO_UPDATE_CHECK=1`이면 자동 확인을 끕니다.
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Mutex, MutexGuard, OnceLock};
+use std::time::Duration;
+
+const RELEASE_API: &str =
+    "https://api.github.com/repos/mozzi-papa/herdr-space-dividers/releases/latest";
+const RELEASE_PAGE_PREFIX: &str = "https://github.com/mozzi-papa/herdr-space-dividers/releases/";
+pub(super) const UPGRADE_COMMAND: &str = "brew upgrade mozzi-papa/tap/herdr-space-dividers";
+const CHECK_INTERVAL: Duration = Duration::from_secs(6 * 60 * 60);
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(super) struct DividersRelease {
+    pub(super) version: String,
+    pub(super) url: String,
+}
+
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub(super) enum DividersUpdateStatus {
+    /// 아직 결과가 없거나 자동 확인에서 새 버전이 없었습니다.
+    #[default]
+    Idle,
+    Checking,
+    UpToDate,
+    Available(DividersRelease),
+    Failed,
+}
+
+#[derive(Clone, Debug, Default)]
+pub(super) struct DividersState {
+    /// 실행기가 알려 준 현재 버전입니다. 없으면 이 기능 전체가 숨겨집니다.
+    pub(super) version: Option<String>,
+    pub(super) status: DividersUpdateStatus,
+    /// 사용자가 직접 확인했을 때만 "최신 버전" · "확인 실패" 결과를 보여 줍니다.
+    pub(super) manual: bool,
+    pub(super) copied: bool,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(super) enum DividersMenuAction {
+    Check,
+    CopyUpdate,
+    OpenRelease,
+    Noop,
+}
+
+// 프로세스에 하나뿐인 업데이트 상태입니다. 확인 스레드와 화면이 함께 읽습니다.
+static STATE: Mutex<DividersState> = Mutex::new(DividersState {
+    version: None,
+    status: DividersUpdateStatus::Idle,
+    manual: false,
+    copied: false,
+});
+
+// 결과가 나오면 화면 루프를 깨워 다시 그리게 합니다. 안 그러면 다음 화면 갱신까지 알림이 늦습니다.
+static WAKE: OnceLock<Box<dyn Fn() + Send + Sync>> = OnceLock::new();
+static CHANGED: AtomicBool = AtomicBool::new(false);
+
+fn notify() {
+    CHANGED.store(true, Ordering::SeqCst);
+    if let Some(wake) = WAKE.get() {
+        wake();
+    }
+}
+
+/// 화면 루프가 호출합니다. 결과가 바뀌었으면 한 번 true를 돌려줍니다.
+pub(super) fn take_changed() -> bool {
+    CHANGED.swap(false, Ordering::SeqCst)
+}
+
+fn state() -> MutexGuard<'static, DividersState> {
+    STATE.lock().unwrap_or_else(|error| error.into_inner())
+}
+
+/// `0.1.3` 또는 `v0.1.3` 형식만 받습니다. 시험판 꼬리표나 잘못된 값은 거부합니다.
+pub(super) fn parse_version(value: &str) -> Option<(u64, u64, u64)> {
+    let mut parts = value.strip_prefix('v').unwrap_or(value).split('.');
+    let mut next = || {
+        let part = parts.next()?;
+        (!part.is_empty() && part.len() <= 9 && part.bytes().all(|b| b.is_ascii_digit()))
+            .then(|| part.parse().ok())
+            .flatten()
+    };
+    let version = (next()?, next()?, next()?);
+    parts.next().is_none().then_some(version)
+}
+
+pub(super) fn is_newer(candidate: &str, current: &str) -> bool {
+    matches!((parse_version(candidate), parse_version(current)), (Some(c), Some(v)) if c > v)
+}
+
+/// GitHub `releases/latest` 응답에서 정식 릴리스만 읽습니다.
+pub(super) fn parse_latest_release(body: &[u8]) -> Result<DividersRelease, String> {
+    let value: serde_json::Value =
+        serde_json::from_slice(body).map_err(|error| format!("응답을 읽지 못했습니다: {error}"))?;
+    if value["draft"].as_bool() == Some(true) || value["prerelease"].as_bool() == Some(true) {
+        return Err("정식 릴리스가 아닙니다.".into());
+    }
+    let tag = value["tag_name"].as_str().unwrap_or_default();
+    parse_version(tag).ok_or("버전 태그 형식이 올바르지 않습니다.")?;
+    let url = value["html_url"].as_str().unwrap_or_default();
+    // 응답에서 온 주소는 이 저장소의 릴리스 페이지일 때만 엽니다.
+    if !url.starts_with(RELEASE_PAGE_PREFIX) {
+        return Err("릴리스 주소가 올바르지 않습니다.".into());
+    }
+    Ok(DividersRelease {
+        version: tag.strip_prefix('v').unwrap_or(tag).to_owned(),
+        url: url.to_owned(),
+    })
+}
+
+fn fetch_latest_release() -> Result<DividersRelease, String> {
+    let output = crate::noninteractive_process::curl_command()
+        .args([
+            "-sfL",
+            "--connect-timeout",
+            "5",
+            "--max-time",
+            "10",
+            "-H",
+            "Accept: application/vnd.github+json",
+            "-H",
+            "User-Agent: herdr-space-dividers",
+            RELEASE_API,
+        ])
+        .output()
+        .map_err(|error| format!("curl 실행 실패: {error}"))?;
+    if !output.status.success() {
+        return Err("최신 버전 정보를 가져오지 못했습니다.".into());
+    }
+    parse_latest_release(&output.stdout)
+}
+
+fn apply_result(state: &mut DividersState, current: &str, result: Result<DividersRelease, String>) {
+    match result {
+        Ok(release) if is_newer(&release.version, current) => {
+            if state.status != DividersUpdateStatus::Available(release.clone()) {
+                state.copied = false;
+            }
+            state.status = DividersUpdateStatus::Available(release);
+        }
+        Ok(_) => state.status = DividersUpdateStatus::UpToDate,
+        // 이미 알게 된 새 버전은 일시적인 네트워크 실패로 지우지 않습니다.
+        Err(_) if matches!(state.status, DividersUpdateStatus::Available(_)) => {}
+        Err(_) => state.status = DividersUpdateStatus::Failed,
+    }
+}
+
+fn finish_check(current: &str, result: Result<DividersRelease, String>) {
+    apply_result(&mut state(), current, result);
+    notify();
+}
+
+/// 실행기가 넘긴 버전을 읽고, 켜져 있으면 6시간마다 업데이트를 확인하는 스레드를 시작합니다.
+pub(crate) fn start_update_checks(wake: impl Fn() + Send + Sync + 'static) {
+    let Some(version) = std::env::var("HERDR_DIVIDERS_VERSION")
+        .ok()
+        .filter(|value| parse_version(value).is_some())
+    else {
+        return;
+    };
+    state().version = Some(version.clone());
+    let _ = WAKE.set(Box::new(wake));
+    if std::env::var("HERDR_DIVIDERS_NO_UPDATE_CHECK").is_ok_and(|value| value == "1") {
+        return;
+    }
+    std::thread::spawn(move || loop {
+        state().manual = false;
+        finish_check(&version, fetch_latest_release());
+        std::thread::sleep(CHECK_INTERVAL);
+    });
+}
+
+/// 메뉴에서 직접 확인합니다. 이미 확인 중이면 새로 시작하지 않습니다.
+pub(super) fn check_now() {
+    let version = {
+        let mut state = state();
+        let Some(version) = state.version.clone() else {
+            return;
+        };
+        if state.status == DividersUpdateStatus::Checking {
+            return;
+        }
+        state.manual = true;
+        if !matches!(state.status, DividersUpdateStatus::Available(_)) {
+            state.status = DividersUpdateStatus::Checking;
+        }
+        version
+    };
+    notify();
+    std::thread::spawn(move || finish_check(&version, fetch_latest_release()));
+}
+
+pub(super) fn update_available() -> bool {
+    matches!(state().status, DividersUpdateStatus::Available(_))
+}
+
+pub(super) fn release_url() -> Option<String> {
+    match &state().status {
+        DividersUpdateStatus::Available(release) => Some(release.url.clone()),
+        _ => None,
+    }
+}
+
+pub(super) fn mark_copied() {
+    state().copied = true;
+}
+
+pub(super) fn menu_rows() -> Vec<(String, DividersMenuAction)> {
+    build_menu_rows(&state())
+}
+
+pub(super) fn build_menu_rows(state: &DividersState) -> Vec<(String, DividersMenuAction)> {
+    use DividersMenuAction as Action;
+    let Some(version) = state.version.as_deref() else {
+        return Vec::new();
+    };
+    let mut rows = vec![(format!("Herdr Space Dividers {version}"), Action::Check)];
+    match &state.status {
+        DividersUpdateStatus::Idle => {}
+        DividersUpdateStatus::Checking => rows.push(("  확인 중…".into(), Action::Noop)),
+        DividersUpdateStatus::UpToDate if state.manual => {
+            rows.push(("  최신 버전입니다".into(), Action::Noop));
+        }
+        DividersUpdateStatus::Failed if state.manual => {
+            rows.push(("  확인 실패 · 네트워크 확인".into(), Action::Noop));
+        }
+        DividersUpdateStatus::UpToDate | DividersUpdateStatus::Failed => {}
+        DividersUpdateStatus::Available(release) => {
+            rows.push((
+                if state.copied {
+                    "  명령 복사됨 · 터미널에 붙여넣기".into()
+                } else {
+                    format!("  {} 업데이트 · 명령 복사", release.version)
+                },
+                Action::CopyUpdate,
+            ));
+            rows.push(("  릴리스 노트 열기".into(), Action::OpenRelease));
+        }
+    }
+    rows
+}
