@@ -0,0 +1,350 @@
+// Modified for Herdr Space Dividers by mozzi-papa, 2026.
+// Based on Herdr v0.9.5; distributed under Apache-2.0.
+use super::*;
+
+pub(super) enum DividerRow {
+    Workspace(WorkspaceEntry, bool),
+    // 구분선이 하나 이상일 때 맨 위에 고정으로 보이는 `미분류` 헤더입니다.
+    Ungrouped { count: usize },
+    Divider { index: usize, count: usize },
+}
+
+// 숫자 이동용 전체 순서와 접힌 항목을 제외한 화면 순서를 같은 자료에서 만듭니다.
+// 분류 순서는 `dividers` 벡터 순서이고, 소속은 `members`(워크스페이스 ID)로만 정합니다.
+pub(super) fn rows(
+    snapshot: &ClientShellSnapshot,
+    entries: &[WorkspaceEntry],
+    dividers: &[SidebarDivider],
+    show_collapsed: bool,
+) -> Vec<DividerRow> {
+    if dividers.is_empty() {
+        return entries
+            .iter()
+            .map(|entry| DividerRow::Workspace(*entry, false))
+            .collect();
+    }
+    let mut owners = HashMap::<&str, usize>::new();
+    for (index, divider) in dividers.iter().enumerate() {
+        for member in divider.members.iter().flatten() {
+            owners.entry(member).or_insert(index);
+        }
+    }
+    // 마지막 칸은 미분류입니다.
+    let mut groups = vec![Vec::new(); dividers.len() + 1];
+    let mut parent_owners = HashMap::new();
+    for entry in entries {
+        let workspace = &snapshot.workspaces[entry.index];
+        let mut owner = owners.get(workspace.workspace_id.as_str()).copied();
+        if let Some(worktree) = &workspace.worktree {
+            if !entry.indented {
+                parent_owners.insert(worktree.key.as_str(), owner);
+            } else if let Some(parent) = parent_owners.get(worktree.key.as_str()) {
+                owner = *parent;
+            }
+        }
+        groups[owner.unwrap_or(dividers.len())].push(*entry);
+    }
+    let ungrouped = groups.pop().unwrap_or_default();
+    let mut result = vec![DividerRow::Ungrouped {
+        count: ungrouped.len(),
+    }];
+    result.extend(
+        ungrouped
+            .iter()
+            .map(|entry| DividerRow::Workspace(*entry, true)),
+    );
+    for (index, group) in groups.iter().enumerate() {
+        result.push(DividerRow::Divider {
+            index,
+            count: group.len(),
+        });
+        if show_collapsed || !dividers[index].collapsed {
+            result.extend(
+                group
+                    .iter()
+                    .map(|entry| DividerRow::Workspace(*entry, true)),
+            );
+        }
+    }
+    result
+}
+
+impl ClientShellState {
+    pub(super) fn divider_of(&self, workspace_id: &str) -> Option<usize> {
+        self.dividers.iter().position(|divider| {
+            divider
+                .members
+                .as_ref()
+                .is_some_and(|members| members.iter().any(|id| id == workspace_id))
+        })
+    }
+
+    // 0.1.0/0.1.1 형식(members 없음)만 저장된 위치로 한 번 소속을 정합니다.
+    // 위치는 스페이스 목록 기준 경계이고, 이미 다른 분류에 속한 스페이스는 건드리지 않습니다.
+    pub(super) fn migrate_legacy_dividers(&mut self) -> bool {
+        if !self.active_endpoint_id.is_local()
+            || self
+                .dividers
+                .iter()
+                .all(|divider| divider.members.is_some())
+        {
+            return false;
+        }
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return false;
+        };
+        let order = render::workspace_entries(snapshot, &self.collapsed_groups)
+            .iter()
+            .map(|entry| snapshot.workspaces[entry.index].workspace_id.clone())
+            .collect::<Vec<_>>();
+        // 서버가 아직 스페이스를 못 보낸 순간에 소속이 빈 목록으로 확정되지 않게 기다립니다.
+        if order.is_empty() {
+            return false;
+        }
+        let owned = self
+            .dividers
+            .iter()
+            .flat_map(|divider| divider.members.iter().flatten().cloned())
+            .collect::<HashSet<_>>();
+        self.dividers.sort_by_key(|divider| divider.position);
+        for index in 0..self.dividers.len() {
+            if self.dividers[index].members.is_some() {
+                continue;
+            }
+            let start = self.dividers[index].position.min(order.len());
+            let end = self
+                .dividers
+                .get(index + 1)
+                .map_or(order.len(), |next| next.position.min(order.len()))
+                .max(start);
+            self.dividers[index].members = Some(
+                order[start..end]
+                    .iter()
+                    .filter(|id| !owned.contains(*id))
+                    .cloned()
+                    .collect(),
+            );
+        }
+        true
+    }
+
+    // 구 버전 클라이언트가 읽을 수 있도록 현재 화면 순서에서 계산한 경계 위치를 기록합니다.
+    // 새 버전은 이 값을 읽지 않습니다.
+    pub(super) fn sync_divider_positions(&mut self) {
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return;
+        };
+        if !self.active_endpoint_id.is_local()
+            || self
+                .dividers
+                .iter()
+                .any(|divider| divider.members.is_none())
+        {
+            return;
+        }
+        let entries = render::workspace_entries(snapshot, &self.collapsed_groups);
+        let mut position = 0;
+        for row in rows(snapshot, &entries, &self.dividers, true) {
+            match row {
+                DividerRow::Workspace(..) => position += 1,
+                DividerRow::Divider { index, .. } => self.dividers[index].position = position,
+                DividerRow::Ungrouped { .. } => {}
+            }
+        }
+    }
+
+    pub(super) fn checkpoint_dividers(&mut self) {
+        if self.divider_undo.len() == 20 {
+            self.divider_undo.pop_front();
+        }
+        self.divider_undo.push_back(self.dividers.clone());
+    }
+
+    // 화면 행 목록이 전부 보이는지, 마지막 행이 보이는지 확인합니다.
+    fn visible_list(&self) -> (bool, bool) {
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return (false, false);
+        };
+        let entries = render::workspace_entries(snapshot, &self.collapsed_groups);
+        let rows = rows(snapshot, &entries, &self.dividers, false);
+        let visible = self.hits.workspaces.len()
+            + self.hits.divider_rows.len()
+            + usize::from(!self.hits.ungrouped_header.is_empty());
+        let end_visible = match rows.last() {
+            Some(DividerRow::Divider { index, .. }) => {
+                self.hits.divider_rows.iter().any(|(_, i)| i == index)
+            }
+            Some(DividerRow::Workspace(entry, _)) => self
+                .hits
+                .workspaces
+                .iter()
+                .any(|hit| hit.workspace_id == snapshot.workspaces[entry.index].workspace_id),
+            _ => false,
+        };
+        (rows.len() == visible, end_visible)
+    }
+
+    fn list_bottom(&self) -> u16 {
+        self.hits
+            .workspaces
+            .iter()
+            .map(|hit| hit.rect.bottom())
+            .chain(self.hits.divider_rows.iter().map(|(rect, _)| rect.bottom()))
+            .max()
+            .unwrap_or(0)
+    }
+
+    // 구분선을 놓을 자리는 분류 덩어리 경계뿐입니다: 각 구분선 앞(헤더 위 빈 줄)과 맨 아래.
+    // 미분류 헤더 앞은 자리가 아니므로 미분류는 항상 첫 번째로 남습니다.
+    // 반환값은 (앞에 끼울 구분선 번호 또는 맨 아래면 개수, 표시 행)입니다.
+    pub(super) fn divider_drop_target_at(&self, point: (u16, u16)) -> Option<(usize, u16)> {
+        if !super::contains(self.hits.workspace_body, point) {
+            return None;
+        }
+        let last_row = self.hits.workspace_body.bottom().saturating_sub(1);
+        let mut slots = self
+            .hits
+            .divider_rows
+            .iter()
+            .map(|(rect, index)| (*index, rect.y.saturating_sub(1)))
+            .collect::<Vec<_>>();
+        if self.visible_list().1 {
+            slots.push((self.dividers.len(), self.list_bottom().min(last_row)));
+        }
+        slots
+            .into_iter()
+            .min_by_key(|(_, row)| row.abs_diff(point.1))
+    }
+
+    // 분류(헤더와 소속 전체)를 통째로 `before` 구분선 앞(개수와 같으면 맨 아래)으로 옮깁니다.
+    // 소속은 바꾸지 않습니다.
+    pub(super) fn move_divider(
+        &mut self,
+        index: usize,
+        before: usize,
+        outcome: &mut ClientShellInput,
+    ) {
+        if index >= self.dividers.len()
+            || before > self.dividers.len()
+            || before == index
+            || before == index + 1
+        {
+            return;
+        }
+        self.checkpoint_dividers();
+        let divider = self.dividers.remove(index);
+        let at = if before > index { before - 1 } else { before };
+        self.dividers.insert(at, divider);
+        self.persist_chrome_preferences(outcome);
+    }
+
+    // 스페이스를 놓은 행이 속한 분류입니다. None이면 미분류입니다.
+    // 마지막 행 아래 빈 공간은 미분류로 봅니다. 스크롤 등으로 목록이 일부만 보이면
+    // 빈 공간을 확신할 수 없어 적용하지 않습니다.
+    fn workspace_drop_divider(&self, row: u16) -> Option<usize> {
+        if self.visible_list().0 && row >= self.list_bottom() {
+            return None;
+        }
+        let header = (!self.hits.ungrouped_header.is_empty())
+            .then_some((self.hits.ungrouped_header.y, None));
+        self.hits
+            .divider_rows
+            .iter()
+            .map(|(rect, index)| (rect.y, Some(*index)))
+            .chain(header)
+            .chain(
+                self.hits
+                    .workspaces
+                    .iter()
+                    .map(|hit| (hit.rect.y, self.divider_of(&hit.workspace_id))),
+            )
+            .filter(|(y, _)| *y <= row)
+            .max_by_key(|(y, _)| *y)
+            .and_then(|(_, owner)| owner)
+    }
+
+    // 스페이스와 같은 worktree 묶음의 ID 전체입니다.
+    fn workspace_block_ids(&self, workspace_id: &str) -> Vec<String> {
+        let Some(snapshot) = self.snapshot.as_deref() else {
+            return Vec::new();
+        };
+        let key = snapshot
+            .workspaces
+            .iter()
+            .find(|workspace| workspace.workspace_id == workspace_id)
+            .and_then(|workspace| workspace.worktree.as_ref())
+            .map(|worktree| worktree.key.as_str());
+        snapshot
+            .workspaces
+            .iter()
+            .filter(|candidate| {
+                candidate.workspace_id == workspace_id
+                    || key.is_some_and(|key| {
+                        candidate
+                            .worktree
+                            .as_ref()
+                            .is_some_and(|other| other.key == key)
+                    })
+            })
+            .map(|workspace| workspace.workspace_id.clone())
+            .collect()
+    }
+
+    pub(super) fn move_workspace_divider(
+        &mut self,
+        workspace_id: &str,
+        row: u16,
+        outcome: &mut ClientShellInput,
+    ) {
+        if !self.active_endpoint_id.is_local() || self.hits.divider_rows.is_empty() {
+            return;
+        }
+        let target = self.workspace_drop_divider(row);
+        if self.divider_of(workspace_id) == target {
+            return;
+        }
+        let ids = self.workspace_block_ids(workspace_id);
+        if ids.is_empty() {
+            return;
+        }
+        self.checkpoint_dividers();
+        for members in self.dividers.iter_mut().filter_map(|d| d.members.as_mut()) {
+            members.retain(|id| !ids.contains(id));
+        }
+        if let Some(target) = target.and_then(|index| self.dividers.get_mut(index)) {
+            target.members.get_or_insert_default().extend(ids);
+            target.collapsed = false;
+        }
+        self.persist_chrome_preferences(outcome);
+    }
+
+    pub(super) fn undo_divider_edit(&mut self, outcome: &mut ClientShellInput) {
+        if let Some(previous) = self.divider_undo.pop_back() {
+            self.dividers = previous;
+            self.persist_chrome_preferences(outcome);
+            self.reveal_focused_workspace = true;
+            outcome.repaint = true;
+        }
+    }
+
+    pub(super) fn toggle_divider(&mut self, index: usize, outcome: &mut ClientShellInput) {
+        if let Some(divider) = self.dividers.get_mut(index) {
+            divider.collapsed = !divider.collapsed;
+            self.persist_chrome_preferences(outcome);
+            outcome.repaint = true;
+        }
+    }
+
+    pub(super) fn expand_divider_for(&mut self, workspace_id: &str) {
+        if !self.active_endpoint_id.is_local() {
+            return;
+        }
