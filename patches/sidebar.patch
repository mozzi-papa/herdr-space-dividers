+fn divider_persistence_handles_invalid_entries_and_storage_errors() {
+    let legacy: preferences::ClientChromePreferences =
+        serde_json::from_str(r#"{"sidebar_width":31}"#).unwrap();
+    assert!(legacy.dividers.is_empty());
+    for value in ["null", "42", r#""invalid""#] {
+        let restored: preferences::ClientChromePreferences =
+            serde_json::from_str(&format!(r#"{{"sidebar_width":31,"dividers":{value}}}"#)).unwrap();
+        assert!(restored.dividers.is_empty());
+        assert_eq!(restored.sidebar_width, Some(31));
+    }
+    let bad = serde_json::json!({"sidebar_width":31, "dividers":[
+        {"position":0,"title":"  업무\u{1b}  "}, {"position":-1,"title":"skip"},
+        {"position":0,"title":" "}, {"position":1}, false,
+        {"position":2,"title":"개인".repeat(100)}
+    ]});
+    let restored: preferences::ClientChromePreferences = serde_json::from_value(bad).unwrap();
+    assert_eq!(restored.sidebar_width, Some(31));
+    assert_eq!(restored.dividers.len(), 2);
+    assert_eq!(restored.dividers[0].title, "업무");
+    assert_eq!(restored.dividers[1].title.chars().count(), 60);
+    let many =
+        serde_json::json!({"dividers":vec![serde_json::json!({"position":0,"title":"valid"});40]});
+    let restored: preferences::ClientChromePreferences = serde_json::from_value(many).unwrap();
+    assert_eq!(restored.dividers.len(), 32);
+    let directory = std::env::temp_dir().join(format!(
+        "herdr-divider-write-failure-{}",
+        std::process::id()
+    ));
+    std::fs::create_dir_all(&directory).unwrap();
+    let config =
+        ClientShellConfig::from_config(&Config::default()).with_preferences_path(directory.clone());
+    let mut state = ClientShellState::new(config);
+    state.open_new_divider_overlay();
+    let outcome = state.handle_input_bytes(b"Keep in memory\r");
+    assert!(outcome.actions.is_empty());
+    assert!(state.endpoint_error.is_some());
+    assert_eq!(
+        state.dividers.len(),
+        1,
+        "저장 실패 시 화면의 구분선은 유지합니다."
+    );
+    std::fs::remove_dir(directory).unwrap();
+}
