+// 전각 문자의 후속 셀을 건너뛰어 화면의 실제 문자열을 복원합니다.
+fn frame_text(frame: &crate::client::frame_output::ComposedFrame) -> String {
+    let mut text = String::new();
+    for row in frame.cells.chunks(frame.width as usize) {
+        let mut skip = 0;
+        for cell in row {
+            if skip > 0 {
+                skip -= 1;
+                continue;
+            }
+            text.push_str(&cell.symbol);
+            skip = UnicodeWidthStr::width(cell.symbol.as_str()).saturating_sub(1);
+        }
+        text.push('\n');
+    }
+    text
+}
