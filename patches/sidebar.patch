+        "구분선은 서버 API를 호출하지 않습니다."
+    );
+    assert_eq!(state.dividers.len(), 1);
+    let frame = state.compose(120, 40).unwrap();
+    // 전각 문자의 후속 셀을 건너뛰어 화면의 실제 문자열을 복원합니다.
+    let mut text = String::new();
+    for row in frame.cells.chunks(frame.width as usize) {
+        let mut skip = 0;
+        for cell in row {
+            if skip > 0 {
+                skip -= 1;
+                continue;
+            }
+            text.push_str(&cell.symbol);
+            skip = UnicodeWidthStr::width(cell.symbol.as_str()).saturating_sub(1);
+        }
+    }
+    assert_eq!(state.dividers[0].title, "업무");
+    assert!(text.contains("▼ 업무 · 1 "));
+    assert_eq!(state.hits.workspaces.len(), 2);
+    assert_eq!(state.snapshot.as_ref().unwrap().workspaces.len(), 2);
+    assert_eq!(state.snapshot.as_ref().unwrap().panes.len(), 1);
+    assert_eq!(
+        state
+            .navigation_workspace_entries(state.snapshot.as_ref().unwrap())
+            .len(),
+        2
+    );
+    // Command+2 must focus the second real workspace, skipping the divider.
+    let focus = state.handle_input_bytes(b"\x1b[50;9u");
+    let [ClientShellAction::Endpoint { request, .. }] = &focus.actions[..] else {
+        panic!("실제 스페이스 이동 필요");
+    };
+    assert!(
+        matches!(&request.method, crate::api::schema::Method::WorkspaceFocus(target) if target.workspace_id == "ws_2")
+    );
+    let first = &state.hits.workspaces[0];
+    let second = &state.hits.workspaces[1];
+    assert_eq!(second.rect.y, first.rect.bottom() + 2);
+    let (divider, _) = state.hits.divider_rows[0];
+    assert_eq!(divider.y, first.rect.bottom() + 1);
+    assert_eq!(divider.height, 1);
+    let margin = &frame.cells[(first.rect.bottom() * frame.width + divider.x) as usize..]
+        [..divider.width as usize];
+    assert!(
+        margin.iter().all(|cell| cell.symbol == " "),
+        "구분선 위는 한 줄 비웁니다."
+    );
+    // A divider remains at a visual slot when workspace order changes.
+    let mut reordered = state.snapshot.as_deref().unwrap().clone();
+    reordered.workspaces.swap(0, 1);
+    state.set_snapshot(Box::new(reordered));
+    state.compose(120, 40).unwrap();
+    assert_eq!(state.dividers[0].position, 1);
+    assert_eq!(state.hits.workspaces[0].workspace_id, "ws_1");
+    assert_eq!(
+        state.dividers[0].members.as_deref(),
+        Some(&["ws_2".to_owned()][..])
+    );
+}
