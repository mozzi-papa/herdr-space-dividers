+#[test]
+fn divider_drag_moves_whole_group_top_middle_bottom_without_changing_members() {
+    let mut state = grouped_state(6, &[("A", &[1, 2]), ("B", &[3, 4]), ("C", &[5, 6])]);
+    let original = divider_layout(&state);
+    drag_divider_before(&mut state, "C", "A");
+    assert_eq!(
+        divider_layout(&state),
+        layout_in(&["C", "A", "B"], &original)
+    );
+    drag_divider_before(&mut state, "B", "A");
+    assert_eq!(
+        divider_layout(&state),
+        layout_in(&["C", "B", "A"], &original)
+    );
+    // 마지막 분류가 접혀 있어도 맨 아래로 옮길 수 있습니다.
+    state.dividers[2].collapsed = true;
+    drag_divider_to_bottom(&mut state, "C");
+    assert_eq!(
+        divider_layout(&state),
+        layout_in(&["B", "A", "C"], &original)
+    );
+    state.compose(120, 80).unwrap();
+    let ids = state
+        .hits
+        .workspaces
+        .iter()
+        .map(|hit| hit.workspace_id.as_str())
+        .collect::<Vec<_>>();
+    // 접힌 A의 소속은 숨겨진 채 C가 그 아래로 내려갑니다.
+    assert!(state.dividers[1].collapsed);
+    assert_eq!(ids, ["ws_3", "ws_4", "ws_5", "ws_6"]);
+    // 제자리 드롭은 실행 취소 기록도 남기지 않습니다.
+    let history = state.divider_undo.len();
+    drag_divider_before(&mut state, "A", "C");
+    assert_eq!(state.divider_undo.len(), history);
+    state.undo_divider_edit(&mut ClientShellInput::default());
+    assert_eq!(
+        divider_layout(&state),
+        layout_in(&["C", "B", "A"], &original)
+    );
+}
