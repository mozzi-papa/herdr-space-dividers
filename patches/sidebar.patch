+fn divider_groups_state() -> ClientShellState {
+    let config: Config = toml::from_str("[keys]\nswitch_workspace = 'cmd+1..9'\n").unwrap();
+    let mut config = ClientShellConfig::from_config(&config);
+    // 이전 버전의 위치 기반 JSON과 같은 상태로 시작합니다.
+    config.preferences.dividers = vec![
+        SidebarDivider {
+            position: 0,
+            title: "Work".into(),
+            ..Default::default()
+        },
+        SidebarDivider {
+            position: 2,
+            title: "Personal".into(),
+            ..Default::default()
+        },
+    ];
+    let mut state = ClientShellState::new(config);
+    let mut projected = snapshot();
+    for i in 2..=3 {
+        let mut workspace = projected.workspaces[0].clone();
+        workspace.workspace_id = format!("ws_{i}");
+        workspace.label = format!("space-{i}");
+        workspace.focused = false;
+        projected.workspaces.push(workspace);
+    }
+    state.set_snapshot(Box::new(projected));
+    state.set_pane_surface(surface());
+    state
+}
