+            target: ClientRenameTarget::NewDivider { workspace_id: Some(ref id) },
+            ..
+        })) if id == "ws_1"
+    ));
+    state.handle_input_bytes("업무".as_bytes());
+    let submit = state.handle_input_bytes(b"\r");
+    assert!(
+        submit.actions.is_empty(),
+        "구분선은 서버 API를 호출하지 않습니다."
