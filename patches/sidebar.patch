+#[test]
+fn legacy_position_json_migrates_once_and_then_keeps_vector_order() {
+    let path =
+        std::env::temp_dir().join(format!("herdr-divider-legacy-{}.json", std::process::id()));
+    std::fs::write(
+        &path,
+        r#"{"sidebar_width":31,"future_field":true,"dividers":[
+            {"position":2,"title":"B","collapsed":true},
+            {"position":0,"title":"A","unknown":1}
+        ]}"#,
+    )
+    .unwrap();
+    let restore = || {
+        let config =
+            ClientShellConfig::from_config(&Config::default()).with_preferences_path(path.clone());
+        let mut state = ClientShellState::new(config);
+        let mut projected = snapshot();
+        for i in 2..=3 {
+            let mut workspace = projected.workspaces[0].clone();
+            workspace.workspace_id = format!("ws_{i}");
+            workspace.focused = false;
+            projected.workspaces.push(workspace);
+        }
+        state.set_snapshot(Box::new(projected));
+        state.set_pane_surface(surface());
+        state
+    };
+    let mut state = restore();
+    assert_eq!(
+        divider_layout(&state),
+        [
+            ("A".to_owned(), vec!["ws_1".to_owned(), "ws_2".to_owned()]),
+            ("B".to_owned(), vec!["ws_3".to_owned()]),
+        ]
+    );
+    assert!(state.dividers[1].collapsed);
+    let migrated = divider_layout(&state);
+    drag_divider_before(&mut state, "B", "A");
+    assert_eq!(divider_layout(&state), layout_in(&["B", "A"], &migrated));
+    // 서버 순서가 바뀌어도, 다시 불러와도 벡터 순서와 소속이 그대로입니다.
+    let mut reordered = state.snapshot.as_deref().unwrap().clone();
+    reordered.workspaces.reverse();
+    state.set_snapshot(Box::new(reordered));
+    assert_eq!(divider_layout(&state), layout_in(&["B", "A"], &migrated));
+    assert_eq!(
+        divider_layout(&restore()),
+        layout_in(&["B", "A"], &migrated)
+    );
+    let saved: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(&path).unwrap()).unwrap();
+    assert_eq!(saved["dividers"][0]["title"], "B");
+    assert_eq!(saved["dividers"][0]["position"], 0);
+    assert_eq!(saved["dividers"][1]["position"], 1);
+    assert_eq!(saved["sidebar_width"], 31);
+    std::fs::remove_file(path).unwrap();
+}
