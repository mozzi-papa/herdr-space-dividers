#!/bin/sh
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 mozzi-papa
set -eu

# Homebrew의 bin 심볼릭 링크에서도 실제 패키지 위치를 찾습니다.
program_path=$0
while [ -L "$program_path" ]; do
    program_dir=$(CDPATH= cd -- "$(dirname -- "$program_path")" && pwd)
    link_target=$(readlink "$program_path")
    case "$link_target" in
        /*) program_path=$link_target ;;
        *) program_path="$program_dir/$link_target" ;;
    esac
done
package_dir=$(CDPATH= cd -- "$(dirname -- "$program_path")/.." && pwd)
binary="$package_dir/libexec/herdr-client"
version_file="$package_dir/share/herdr-space-dividers/VERSION"

case "${1:-}" in
    -h|--help)
        printf '%s\n' \
            'Herdr Space Dividers — 구분선과 분류가 있는 비공식 Herdr 클라이언트입니다.' \
            '' \
            '사용법: herdr-div [--help | --version]' \
            '인자 없이 실행하면 기존 기본 로컬 Herdr 서버에 연결합니다.' \
            '공식 Herdr 관리 명령은 기존 herdr 명령을 사용해 주세요.' \
            '업데이트: brew upgrade mozzi-papa/tap/herdr-space-dividers'
        exit 0 ;;
    -V|--version)
        package_version=$(cat "$version_file")
        client_version=$("$binary" --version)
        printf 'herdr-div %s (%s)\n' "$package_version" "$client_version"
        exit 0 ;;
    '') ;;
    *) printf '%s\n' '지원하지 않는 인자입니다. herdr-div --help를 확인해 주세요.' >&2; exit 2 ;;
esac

if [ "${HERDR_ENV:-}" = 1 ]; then
    printf '%s\n' '먼저 Ctrl+B 다음 q로 화면을 분리한 뒤 실행해 주세요. 작업 서버는 유지됩니다.' >&2
    exit 1
fi
if [ ! -x "$binary" ]; then
    printf '%s\n' '배포 클라이언트를 찾을 수 없습니다. Homebrew 설치 상태를 확인해 주세요.' >&2
    exit 1
fi
api_socket="$HOME/.config/herdr/herdr.sock"
official=
for candidate in "$HOME/.local/bin/herdr" "$(command -v herdr 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        official=$candidate
        break
    fi
done
# 소켓 파일은 재부팅 뒤에도 남으므로 서버가 살아 있다는 증거가 아닙니다. 실제 응답으로 확인합니다.
server_running() {
    [ -n "$official" ] || return 1
    env -u HERDR_SOCKET_PATH -u HERDR_CLIENT_SOCKET_PATH -u HERDR_CONFIG_PATH \
        "$official" status server 2>/dev/null | grep -qx 'status: running'
}
if ! server_running; then
    if [ -z "$official" ]; then
        printf '%s\n' '공식 herdr를 찾을 수 없어 서버를 시작하지 못했습니다.' \
            '터미널에서 command herdr 를 먼저 실행해 서버를 시작한 뒤 다시 실행해 주세요.' >&2
        exit 1
    fi
    printf '%s\n' '공식 Herdr 서버가 응답하지 않아 시작합니다. 저장된 세션을 복원합니다...' >&2
    # 이 명령이 끝나도 서버가 살아남도록 새 세션(setsid)으로 분리합니다.
    (cd "$HOME" && exec env -u HERDR_SOCKET_PATH -u HERDR_CLIENT_SOCKET_PATH -u HERDR_CONFIG_PATH \
        perl -MPOSIX -e 'POSIX::setsid(); exec @ARGV' "$official" server \
        </dev/null >/dev/null 2>&1) &
    tries=0
    until server_running; do
        tries=$((tries + 1))
        if [ "$tries" -ge 40 ]; then
            printf '%s\n' '공식 Herdr 서버가 20초 안에 시작되지 않았습니다.' \
                '~/.config/herdr/herdr-server.log를 확인하거나 command herdr 로 순정 Herdr를 직접 실행해 주세요.' >&2
            exit 1
        fi
        sleep 0.5
    done
fi
# 화면의 버전 표시와 업데이트 확인에 쓰는 값입니다. 읽지 못하면 빈 값이라 해당 기능만 꺼집니다.
dividers_version=$(cat "$version_file" 2>/dev/null || true)
exec env -u HERDR_CLIENT_SOCKET_PATH \
    HERDR_CONFIG_PATH="$HOME/.config/herdr/config.toml" \
    HERDR_SOCKET_PATH="$api_socket" \
    HERDR_DIVIDERS_VERSION="$dividers_version" \
    "$binary"
